# ==============================================================================
# CrediSense - Modèle de variables d'environnement (.env.example)
# ==============================================================================

# Clés API pour les modèles d'intelligence artificielle
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Workflow Dify (si utilisé)
DIFY_API_KEY=
DIFY_API_URL=https://api.dify.ai/v1

# Sécurité (JWT / Chiffrement)
SECRET_KEY=credisense-dev-secret-key-32charsminimum!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de données
# Local SQLite : sqlite:///./credit_simulateur.db
# TiDB Cloud : mysql+pymysql://<USER>:<PASSWORD>@<HOST>:4000/<DB>?ssl_verify_cert=true&ssl_verify_identity=true
DATABASE_URL=sqlite:///./credit_simulateur.db

# Configuration Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true
DEMANDES_EMAIL_DESTINATAIRE=
